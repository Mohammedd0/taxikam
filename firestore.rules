rules_version = '2';
// یاساکانی ئاسایشی تەکسیەکەم
// هەر تۆمارێکی هاوبەش خانەیەکی «_r»ـی هەیە: لیستی UIDـی ئەو کەسانەی دەتوانن بیخوێننەوە
// (سەرنشینی خاوەن و شۆفێرەکەی). بەڕێوەبەر هەموو شتێک دەبینێت.
// ژمارەی مۆبایلی سەرنشین تەنها لە accounts و pax دایە، کە تەنها خۆی و بەڕێوەبەر دەیانبینن.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isAdmin() {
      return signedIn() && (request.auth.uid in ['H1rrhWrw1KRm0ZdnxK89QBetbaC3']
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    function isDriver() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email.matches('.*@d[.]taxikam[.]app$');
    }
    function isPax() {
      return signedIn() && request.auth.token.email != null && request.auth.token.email.matches('.*@p[.]taxikam[.]app$');
    }
    function inR() { return signedIn() && request.auth.uid in resource.data._r; }
    function inNewR() { return signedIn() && request.auth.uid in request.resource.data._r; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------- گشتی ----------
    match /admins/{id} { allow read: if isAdmin(); allow write: if false; }
    match /meta/{id} { allow read: if true; allow write: if isAdmin(); }
    match /partners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /news/{id} { allow read: if signedIn(); allow write: if isAdmin(); }

    // ---------- تەنها بەڕێوەبەر ----------
    match /broadcasts/{id} { allow read, write: if isAdmin(); }
    match /partnerPays/{id} { allow read, write: if isAdmin(); }
    match /payouts/{id} { allow read: if isAdmin() || inR(); allow write: if isAdmin(); }
    // هەر کەسێک دەتوانێت دروستی بکات، تەنها بەڕێوەبەر دەیخوێنێتەوە
    match /partnerEarnings/{id} { allow read, update, delete: if isAdmin(); allow create: if signedIn(); }
    match /reports/{id} { allow read, update, delete: if isAdmin(); allow create: if signedIn(); }
    match /adminNotices/{id} { allow read, update, delete: if isAdmin(); allow create: if signedIn(); }

    // ---------- ئاگادارکردنەوە و مێژوو (کەسانی تر بۆ خاوەنەکەی دەینووسن) ----------
    // ناردەری نامەیەکی گەڕێنراوە دەتوانێت دەقەکەی لە ئاگادارکردنەوەی وەرگر بسڕێتەوە
    function unsentNotice() {
      return signedIn() && resource.data.get('msgId', null) != null && changed().hasOnly(['body']) && request.resource.data.body == 'ئەم نامەیە گەڕێنرایەوە'
        && get(/databases/$(database)/documents/messages/$(resource.data.msgId)).data.unsent == true
        && (get(/databases/$(database)/documents/messages/$(resource.data.msgId)).data.fromDriver == true
            ? get(/databases/$(database)/documents/messages/$(resource.data.msgId)).data.driverId == uid()
            : get(/databases/$(database)/documents/messages/$(resource.data.msgId)).data.peer == uid());
    }
    match /pnotices/{id} { allow read, delete: if isAdmin() || inR(); allow update: if isAdmin() || inR() || unsentNotice(); allow create: if signedIn(); }
    match /phistory/{id} { allow read, update, delete: if isAdmin() || inR(); allow create: if signedIn(); }
    match /dnotices/{id} { allow read, delete: if isAdmin() || inR(); allow update: if isAdmin() || inR() || unsentNotice(); allow create: if signedIn(); }
    // دەفتەری کۆن (پێش جزدان): سەرنشین تەنها سزای «نەهاتن» بۆ شۆفێری گەشتەکەی خۆی؛ شۆفێر تەنها گواستنەوەی پارەی جێگرەوە بۆ گەشتێکی خۆی
    function tripOf(d) { return get(/databases/$(database)/documents/trips/$(d.tripId)).data; }
    function ledgerPax() {
      let d = request.resource.data;
      return isPax() && d.type == 'penalty' && d.amount is number && d.amount < 0 && d.amount >= -200000 && d.tripId is string
        && uid() in tripOf(d)._r && tripOf(d).driverId == d.driverId;
    }
    function ledgerDriver() {
      let d = request.resource.data;
      return isDriver() && d.type == 'swap' && d.amount is number && d.amount > -1000000 && d.amount < 1000000 && d.tripId is string
        && tripOf(d).driverId == uid() && (d.amount > 0 ? d.driverId == uid() : tripOf(d).originalDriverId == d.driverId);
    }
    match /ledger/{id} { allow read: if isAdmin() || inR(); allow create: if isAdmin() || ledgerPax() || ledgerDriver(); allow update, delete: if isAdmin(); }
    // «resource == null»: ئامێرەکە پێش دروستکردن دەپشکنێت ئایا هەیە (transaction)، بەڵگەنامەی نەبوو هیچ ئاشکرا ناکات
    match /driverLog/{id} { allow read: if resource == null || isAdmin() || inR(); allow update, delete: if isAdmin() || inR(); allow create: if isAdmin() || inNewR(); }

    // ---------- هەژمارەکان ----------
    // ژمارەی مۆبایلی سەرنشین تەنها لێرەدایە: تەنها خۆی و بەڕێوەبەر
    match /accounts/{id} {
      allow read: if isAdmin() || (signedIn() && uid() == id);
      allow create: if isAdmin() || (isPax() && uid() == id && !('blocked' in request.resource.data));
      allow update: if isAdmin() || (signedIn() && uid() == id && !changed().hasAny(['blocked']));
      // سەرنشین دەتوانێت هەژمارەکەی خۆی بسڕێتەوە، مەگەر ڕاگیرابێت
      allow delete: if isAdmin() || (signedIn() && uid() == id && resource.data.get('blocked', false) != true);
    }
    match /pax/{id} { allow read, write: if isAdmin() || (signedIn() && uid() == id); }
    // بەشی تایبەتی شۆفێر (بەڵگەنامە، ناونیشان، موچە)
    match /drivers/{id} {
      allow read: if isAdmin() || (signedIn() && uid() == id);
      // شۆفێر ناتوانێت پشتڕاستکردنەوەی بەڕێوەبەر بۆ شێوازی موچە (payAckFor) بنووسێت
      allow create: if isAdmin() || (isDriver() && uid() == id && !('payAckFor' in request.resource.data) && !('payAckAt' in request.resource.data));
      allow update: if isAdmin() || (signedIn() && uid() == id && !changed().hasAny(['payAckAt', 'payAckFor']));
      allow delete: if isAdmin();
    }
    // شوێنی زیندووی شۆفێر لە کاتی گەشتدا: تەنها سەرنشینانی ئەو گەشتە (_r) و بەڕێوەبەر دەیبینن
    match /live/{id} {
      allow read: if isAdmin() || inR();
      allow create, update: if isDriver() && uid() == id && request.resource.data.d == uid() && request.resource.data._r.size() <= 12;
      allow delete: if isAdmin() || (signedIn() && uid() == id);
    }
    // بەشی گشتی شۆفێر (ناو، ئۆتۆمبێل، هەڵسەنگاندن). شۆفێر خۆی ناتوانێت خۆی چالاک بکات
    match /dpub/{id} {
      allow read: if signedIn();
      allow create: if isAdmin() || (isDriver() && uid() == id && request.resource.data.status == 'pending');
      // شۆفێر خۆی: هەموو شتێک جگە لە دۆخ و هەڵسەنگاندن. سەرنشین: تەنها یەک هەڵسەنگاندن لە جارێکدا (reviews +1، rating لە ١ تا ٥)
      allow update: if isAdmin()
        || (signedIn() && uid() == id && !changed().hasAny(['status', 'rating', 'reviews', 'plateType']))
        || (isPax() && changed().hasOnly(['rating', 'reviews', 'tags', '_t', 'id'])
            && request.resource.data.reviews == resource.data.get('reviews', 0) + 1
            && request.resource.data.rating is number && request.resource.data.rating >= 1 && request.resource.data.rating <= 5)
        // سەرنشین کاتێک بەشداری دەکات کورسییە بەتاڵەکانی شۆفێر کەم دەکاتەوە
        || (isPax() && changed().hasOnly(['freeSeats', '_t', 'id']) && request.resource.data.freeSeats is number
            && request.resource.data.freeSeats >= 0 && request.resource.data.freeSeats <= 20);
      allow delete: if isAdmin();
    }
    match /img/{id} {
      allow read: if isAdmin() || (signedIn() && (resource.data.pub == true || resource.data.o == uid()));
      allow create: if signedIn() && request.resource.data.o == uid();
      allow update, delete: if isAdmin() || (signedIn() && resource.data.o == uid());
    }

    // ---------- تۆمارە هاوبەشەکان (سەرنشین و شۆفێرەکەی) ----------
    match /requests/{id} {
      // شۆفێران داواکارییە کراوەکان دەبینن تا نرخ بنێرن (بێ ژمارەی مۆبایل)
      allow read: if isAdmin() || inR() || (isDriver() && resource.data.status == 'open');
      allow create: if isAdmin() || (isPax() && request.resource.data.owner == uid() && inNewR());
      // خاوەنەکەی هەموو شتێک؛ شۆفێر تەنها نرخ، ڕەتکردنەوە و داخستنی داواکاری ڕاستەوخۆ
      allow update: if isAdmin() || (inR() && resource.data.owner == uid())
        || (isDriver() && (resource.data.status == 'open' || inR()) && changed().hasOnly(['offers', 'declined', '_r', 'status', 'closedReason']));
      allow delete: if isAdmin() || inR();
    }
    match /subscriptions/{id} {
      allow read, delete: if isAdmin() || inR();
      // نرخ و خاوەن دوای دروستکردن ناگۆڕدرێن (تەنها بەڕێوەبەر)
      allow update: if isAdmin() || (inR() && !changed().hasAny(['price', 'owner']));
      allow create: if isAdmin() || inNewR();
    }
    match /trips/{id} {
      // کاتێک شۆفێرێک جێگرەوەی دەوێت، شۆفێرانی تر گەشتەکە دەبینن و دەتوانن وەریبگرن
      allow read: if resource == null || isAdmin() || inR() || (isDriver() && resource.data.swapOpen == true);
      allow update: if isAdmin() || inR() || (isDriver() && resource.data.swapOpen == true);
      allow create: if isAdmin() || inNewR();
      allow delete: if isAdmin() || inR();
    }
    match /swaps/{id} {
      allow read, update: if isAdmin() || inR() || (isDriver() && resource.data.status == 'open');
      allow create: if isAdmin() || inNewR();
      allow delete: if isAdmin() || inR();
    }
    match /routes/{id} {
      allow read, update, delete: if isAdmin() || inR();
      allow create: if isAdmin() || inNewR();
    }
    match /messages/{id} {
      // ناردەری نامەکە
      function sender() { return resource.data.fromDriver == true ? resource.data.driverId == uid() : resource.data.peer == uid(); }
      allow read: if isAdmin() || inR();
      // نامەکان بەڵگەن: تەنها بەڕێوەبەر دەیانسڕێتەوە
      allow delete: if isAdmin();
      allow create: if isAdmin() || inNewR();
      // دەقی نامە ناگۆڕدرێت؛ تەنها ناردەر دەتوانێت تا ٥ خولەک بیگەڕێنێتەوە (١ خولەک زیاتر بۆ جیاوازی کاتژمێر)
      allow update: if isAdmin() || (inR() && (
        !changed().hasAny(['text', 'unsent', 'unsentAt', 'at', 'fromDriver', 'driverId', 'peer'])
        || (sender() && resource.data.get('system', false) != true && changed().hasOnly(['text', 'unsent', 'unsentAt']) && request.resource.data.unsent == true
            && request.resource.data.text == '' && request.time.toMillis() < resource.data.at + 360000)));
    }
    // ---------- بانگهێشتی هاوڕێ ----------
    // کۆدی بانگهێشت ← خاوەنەکەی. هەر کەسێک دەتوانێت یەک کۆد بپشکنێت (get)، بەڵام لیستی هەمووی تەنها بەڕێوەبەر
    match /refcodes/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isPax() && request.resource.data.uid == uid() && code.size() >= 4 && code.size() <= 10
        && request.resource.data.keys().hasOnly(['uid', 'name']);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == uid());
    }
    // پەیوەندی ئەحمەد (inviter) و ئاراس (invitee). ناسنامەی بەڵگەنامە = UIDـی ئاراس (هەر کەسێک تەنها یەک جار)
    match /referrals/{id} {
      allow read: if isAdmin() || inR();
      allow create: if isAdmin() || (isPax() && id == uid() && request.resource.data.invitee == uid()
        && request.resource.data.inviter != uid() && request.resource.data.status == 'joined'
        && request.resource.data.get('inviteeUsedAt', null) == null && request.resource.data.get('inviterUsedAt', null) == null
        && get(/databases/$(database)/documents/refcodes/$(request.resource.data.code)).data.uid == request.resource.data.inviter
        && inNewR());
      // ئاراس: تەنها بەشداری کرد / هەڵیوەشاندەوە / بەکارهێنا. ئەحمەد: تەنها بەکارهێنانی داشکاندنەکەی خۆی
      allow update: if isAdmin()
        || (signedIn() && resource.data.invitee == uid() && resource.data.status != 'revoked'
            && changed().hasOnly(['status', 'subId', 'amount', 'month', 'subAt', 'inviteeUsedAt'])
            && request.resource.data.status in ['joined', 'subscribed', 'cancelled'])
        || (signedIn() && resource.data.inviter == uid() && resource.data.status == 'subscribed' && changed().hasOnly(['inviterUsedAt']));
      allow delete: if isAdmin();
    }
    // دەقی ڕاستەقینەی نامە گەڕێنراوەکان: تەنها بەڕێوەبەر دەیخوێنێتەوە
    match /unsent/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn() && request.resource.data.by == uid();
    }

    // ---------- جزدان ----------
    // دەفتەر: هەر دێڕێک تەنها دروست دەکرێت (هەرگیز ناگۆڕدرێت). پارە زیادکردن بۆ سەرنشین تەنها بەڕێوەبەر.
    // سەرنشین: تەنها پارەدانی مانگ (کەمکردنەوەی باڵانسی خۆی). شۆفێر: تەنها دێڕە سیستەمییەکان (داهاتی گەشت، جێگرەوە، گەڕاندنەوەی «نایەم»)
    function walletPax() {
      let d = request.resource.data;
      return isPax() && d.type == 'monthpay' && d.who == uid() && d.role == 'p' && d.amount is number && d.amount <= 0
        && d.gross is number && d.discount is number && d.discount >= 0 && d.discount <= d.gross && d.amount == d.discount - d.gross
        && d._r is list && uid() in d._r;
    }
    // ناردنی پارە لە جزدانێکەوە بۆ جزدانێکی تر: تەنها لە باڵانسی خۆی (بڕی سالب)، سەرنشین بۆ سەرنشین و شۆفێر بۆ شۆفێر
    function walletXfer() {
      let d = request.resource.data;
      return d.type == 'xfer' && d.who == uid() && d.amount is number && d.amount < 0 && d.amount > -5000000
        && d.to is string && d.to != uid() && d._r is list && d._r.size() == 2 && uid() in d._r && d.to in d._r
        && ((isPax() && d.role == 'p' && exists(/databases/$(database)/documents/accounts/$(d.to)))
          || (isDriver() && d.role == 'd' && exists(/databases/$(database)/documents/dpub/$(d.to))));
    }
    // شۆفێر تەنها دێڕی خۆی دەنووسێت (earn, swapin, skipdeduct)؛ swapout بۆ شۆفێری ئەسڵی تەنها بە گەشتێک کە ئێستا هی خۆیەتی؛
    // skipref بۆ سەرنشینێک تەنها ئەگەر بەشدارییەکە هی ئەم شۆفێرە بێت
    function subOf(d) { return get(/databases/$(database)/documents/subscriptions/$(d.subId)).data; }
    function walletDriver() {
      let d = request.resource.data;
      return isDriver() && d.type in ['earn', 'swapout', 'swapin', 'skipref', 'skipdeduct'] && d.amount is number
        && d.amount > -1000000 && d.amount < 1000000 && d._r == [d.who]
        && (d.type != 'skipref' || (d.role == 'p' && d.amount > 0 && d.subId is string && subOf(d).driverId == uid() && subOf(d).owner == d.who))
        && (d.type == 'skipref' || d.role == 'd')
        && (d.type != 'earn' || (d.amount > 0 && d.amount <= 200000 && d.tripId is string && tripOf(d).driverId == uid()
            && !(tripOf(d).status in ['scheduled', 'active']) && (d.who == uid() || tripOf(d).originalDriverId == d.who)))
        && (d.type != 'swapin' || (d.who == uid() && d.amount > 0))
        && (d.type != 'skipdeduct' || (d.who == uid() && d.amount < 0))
        && (d.type != 'swapout' || (d.amount < 0 && d.who != uid() && d.tripId is string && tripOf(d).driverId == uid() && tripOf(d).originalDriverId == d.who));
    }
    match /wallet/{id} {
      // resource == null: دروستکردن بە transaction سەرەتا دەپشکنێت ئایا هەیە (هەمان ناسنامە لە دوو ئامێر)
      allow read: if resource == null || isAdmin() || inR();
      allow create: if isAdmin() || walletPax() || walletDriver() || walletXfer();
      allow update: if false;
      allow delete: if isAdmin();
    }
    // داواکاری پڕکردنەوە: سەرنشین یان شۆفێر دروستی دەکات (چاوەڕێ) یان هەڵیدەوەشێنێتەوە؛ پەسەندکردن تەنها بەڕێوەبەر
    match /topups/{id} {
      allow read: if isAdmin() || inR();
      allow create: if isAdmin() || ((isPax() || isDriver()) && request.resource.data.owner == uid() && request.resource.data.status == 'pending'
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data._r == [uid()]);
      allow update: if isAdmin() || (inR() && resource.data.owner == uid() && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled' && changed().hasOnly(['status']));
      allow delete: if isAdmin();
    }
    // داوای ڕاکێشان (driverId = خاوەنەکەی، شۆفێر یان سەرنشین): خۆی دروستی دەکات یان هەڵیدەوەشێنێتەوە؛ ناردنی پارە تەنها بەڕێوەبەر
    match /withdraws/{id} {
      allow read: if isAdmin() || inR();
      allow create: if isAdmin() || ((isDriver() || isPax()) && request.resource.data.driverId == uid() && request.resource.data.status == 'pending'
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data._r == [uid()]);
      allow update: if isAdmin() || (inR() && resource.data.driverId == uid() && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled' && changed().hasOnly(['status']));
      allow delete: if isAdmin();
    }
    // ناوی خاوەنی ژمارەیەک بۆ «ناردن» (سەرنشین تەنها سەرنشین دەدۆزێتەوە، شۆفێر تەنها شۆفێر). تەنها get، لیست نا.
    // هەر کەسێک تەنها بەڵگەنامەی ژمارەی خۆی دەنووسێت (لە ئیمەیڵی چوونەژوورەوە دەناسرێتەوە)
    match /pdir/{phone} {
      allow get: if isPax() || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isPax() && request.auth.token.email == phone + '@p.taxikam.app'
        && request.resource.data.uid == uid() && request.resource.data.keys().hasOnly(['uid', 'name']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == uid());
    }
    match /ddir/{phone} {
      allow get: if isDriver() || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isDriver() && request.auth.token.email == phone + '@d.taxikam.app'
        && request.resource.data.uid == uid() && request.resource.data.keys().hasOnly(['uid', 'name']);
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == uid());
    }
  }
}
